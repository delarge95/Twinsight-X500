/* ════════════════════════════════════════════════════════════════
   TwinSight X500 — PC desktop additions (phase 2A).
   Loaded at runtime ONLY in Standalone builds by DesktopUIController
   (the class .desktop-ui is added to the UIDocument root), so WebGL never sees it.
   Same tokens as Theme.uss: celeste rgb(70,175,255), white 0.65 muted text, pills.
   ════════════════════════════════════════════════════════════════ */

/* ── Minimum pointer target: 44 px (agreed with the web) ── */
.desktop-ui .hero-info-btn {
    width: 44px;
    height: 44px;
    border-radius: 22px;
}

.desktop-ui .config-tier-auto {
    height: 48px;
    font-size: 14px;
}

.desktop-ui .config-tier-card {
    height: 44px;
    font-size: 13px;
}

.desktop-ui .config-cycle-btn {
    min-width: 128px;
    height: 44px;
    border-radius: 12px;
    font-size: 13px;
}

.desktop-ui .config-row {
    min-height: 48px;
}

.desktop-ui .config-row-label,
.desktop-ui .config-advanced-section .env-slider-label,
.desktop-ui .config-section-label {
    font-size: 13px;
}

.desktop-ui .about-tool-btn {
    height: 44px;
    min-height: 44px;
    font-size: 13px;
}

.desktop-ui .onboard-close-btn {
    width: 44px;
    height: 44px;
    border-radius: 22px;
}

/* Disabled settings row (resolution while in fullscreen) */
.desktop-ui .config-cycle-btn:disabled {
    opacity: 0.45;
}

/* ── Display section inside CONFIG ── */
.desktop-display-section {
    width: 100%;
    max-width: 360px;
    margin-top: 6px;
    margin-bottom: 18px;
    padding: 12px 14px;
    border-radius: 14px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    align-self: center;
}

.desktop-display-section .env-slider-group {
    width: 100%;
    align-self: stretch;
    flex-direction: column;
    align-items: stretch;
    margin-top: 8px;
}

.desktop-display-section .env-slider-label {
    font-size: 13px;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.72);
    white-space: normal;
    margin-bottom: 4px;
}

.desktop-display-section .env-slider {
    width: 100%;
    flex-grow: 0;
}

/* ── Floating tooltip (label + key caps) ── */
.desktop-tooltip {
    position: absolute;
    flex-direction: row;
    align-items: center;
    padding: 6px 12px;
    background-color: rgba(1, 1, 1, 0.94);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.22);
    border-radius: 12px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.12s;
}

.desktop-tooltip--visible {
    opacity: 1;
}

.desktop-tooltip-text {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.92);
    white-space: nowrap;
    margin: 0;
}

/* ── Key cap pill (tooltips, help overlay, hint) ── */
.desktop-keycap {
    min-width: 28px;
    height: 28px;
    margin-left: 6px;
    padding: 0 10px;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(70, 175, 255, 1);
    background-color: rgba(70, 175, 255, 0.10);
    color: rgba(70, 175, 255, 1);
    font-size: 13px;
    letter-spacing: 0.5px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.desktop-keycap--first {
    margin-left: 0;
}

.desktop-tooltip .desktop-keycap {
    margin-left: 10px;
}

.desktop-keycap-sep {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.45);
    margin-left: 6px;
    -unity-text-align: middle-center;
}

/* ── Shortcut hint pill (bottom-left) ── */
.desktop-hint {
    position: absolute;
    left: 24px;
    bottom: 24px;
    height: 44px;
    flex-direction: row;
    align-items: center;
    padding: 0 16px 0 8px;
    border-radius: 22px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: rgba(0, 0, 0, 0.45);
    transition-property: border-color, background-color, opacity;
    transition-duration: 0.18s;
}

.desktop-hint:hover {
    border-color: rgba(70, 175, 255, 1);
    background-color: rgba(70, 175, 255, 0.08);
}

.desktop-hint--hidden {
    display: none;
}

.desktop-hint-text {
    font-size: 13px;
    letter-spacing: 1.5px;
    color: rgba(255, 255, 255, 0.65);
    -unity-font-style: bold;
    margin-left: 8px;
}

.desktop-hint .desktop-keycap {
    margin-left: 0;
}

/* ── Help overlay ── */
.desktop-help {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.80);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.15s;
}

.desktop-help--visible {
    opacity: 1;
}

.desktop-help--hidden {
    display: none;
}

.desktop-help-card {
    width: 900px;
    max-width: 94%;
    max-height: 94%;
    padding: 22px 36px 18px 36px;
    background-color: rgba(1, 1, 1, 0.96);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.22);
    border-radius: 28px;
}

.desktop-help-title {
    font-size: 24px;
    letter-spacing: 4px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.desktop-help-subtitle {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.55);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.desktop-help-columns {
    flex-direction: row;
    justify-content: space-between;
}

.desktop-help-column {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 12px;
    margin-right: 12px;
}

.desktop-help-section {
    font-size: 12px;
    letter-spacing: 2px;
    color: rgba(255, 255, 255, 0.55);
    -unity-font-style: bold;
    margin-top: 10px;
    margin-bottom: 4px;
}

.desktop-help-row {
    flex-direction: row;
    align-items: center;
    min-height: 34px;
}

.desktop-help-keys {
    width: 190px;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.desktop-help-desc {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.85);
    white-space: normal;
    flex-shrink: 1;
}

.desktop-help-footer {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 18px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
}

.desktop-help-footer-text {
    font-size: 13px;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.55);
    margin-left: 8px;
    margin-right: 8px;
}

/* ════════════════════════════════════════════════════════════════
   Compact layout — added by DesktopUIController when the logical
   window height is under ~900 px (a 1280x720 window).
   ════════════════════════════════════════════════════════════════ */
.ui-compact .top-bar {
    margin-top: 16px;
}

.ui-compact .actions-row {
    height: 96px;
    border-radius: 48px;
    padding: 0 32px;
    min-width: 440px;
}

.ui-compact .mode-btn {
    width: 112px;
    height: 80px;
    margin-left: 8px;
    margin-right: 8px;
}

.ui-compact .mode-btn-icon {
    width: 44px;
    min-width: 44px;
    max-width: 44px;
    height: 44px;
    min-height: 44px;
    max-height: 44px;
    margin-bottom: 4px;
}

.ui-compact .mode-btn-label {
    font-size: 16px;
}

.ui-compact .submenu-card {
    width: 120px;
    height: 104px;
    margin: 3px;
}

.ui-compact .submenu-grid {
    width: 396px;
}

.ui-compact .submenu-icon {
    width: 40px;
    min-width: 40px;
    max-width: 40px;
    height: 40px;
    min-height: 40px;
    max-height: 40px;
    margin-bottom: 4px;
}

.ui-compact .submenu-label {
    font-size: 15px;
}

.ui-compact .submenu-title {
    font-size: 16px;
    margin-bottom: 6px;
}

.ui-compact .submenu-title--section {
    margin-top: 8px;
}

.ui-compact .mode-container {
    margin-bottom: 4px;
}

.ui-compact .mode-submenu {
    padding: 4px 0;
    margin-bottom: 4px;
}

.ui-compact .thermal-legend {
    height: 240px;
    bottom: 160px;
}

/* Help overlay — narrow key column (single cap) and compact sizing */
.desktop-help-column--narrow .desktop-help-keys {
    width: 56px;
}

.ui-compact .desktop-help-card {
    padding: 14px 28px 12px 28px;
}

.ui-compact .desktop-help-row {
    min-height: 30px;
}

.ui-compact .desktop-help-desc {
    font-size: 15px;
}

.ui-compact .desktop-help-section {
    margin-top: 6px;
}

.ui-compact .desktop-help-footer {
    margin-top: 10px;
}

/* ════════════════════════════════════════════════════════════════
   Phase 2B — desktop layout (class .layout--desktop on the Root, set by DesktopSidePanel).
   The part details become a docked panel on the right; the capsule + mode sub-panels (BottomBar)
   stay at the bottom centre of the FREE area (DesktopSidePanel moves the bar's right edge).
   Every selector has 2+ classes so it beats the single-class rules of Theme.uss.
   ════════════════════════════════════════════════════════════════ */

.layout--desktop .bottom-bar {
    transition-property: bottom, translate, right;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

/* The old sheet pushed the bar up: the side panel never does. */
.layout--desktop .ui-shifted,
.layout--desktop .ui-shifted-soft {
    bottom: 0;
    translate: 0 0;
}

.layout--desktop .actions-row--sheet-open {
    background-color: transparent;
    border-color: rgba(255, 255, 255, 0.3);
}

/* ── Docked details panel (right, full height between the header and the bottom edge) ── */
.layout--desktop .details-sheet {
    left: auto;
    right: 16px;
    top: 112px;
    bottom: 16px;
    width: 480px;
    height: auto;
    padding: 18px 8px 16px 24px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 24px;
    background-color: rgba(5, 7, 11, 0.98);
    translate: 0 0;
    opacity: 1;
    transition-property: translate, opacity;
    transition-duration: 0.3s, 0.25s;
    transition-timing-function: ease-out, ease-out;
}

.layout--desktop .details-sheet--hidden {
    translate: 115% 0;
    opacity: 0;
}

.layout--desktop .sheet-handle {
    display: none;
}

.layout--desktop .sheet-header {
    padding-right: 56px;
    margin-bottom: 2px;
}

.layout--desktop .sheet-title {
    font-size: 24px;
    white-space: normal;
    flex-shrink: 1;
}

.layout--desktop .sheet-close-btn {
    top: 14px;
    right: 14px;
    width: 44px;
    height: 44px;
    border-radius: 22px;
}

.layout--desktop .sheet-close-icon {
    width: 22px;
    min-width: 22px;
    max-width: 22px;
    height: 22px;
    min-height: 22px;
    max-height: 22px;
}

.layout--desktop .sheet-scroll {
    margin-top: 6px;
    padding-right: 12px;
}

/* Reading width: the panel content is ~432 px; 14-15 px type gives 55-65 characters per line. */
.layout--desktop .sheet-description {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.60);
    padding-right: 0;
    margin-bottom: 14px;
}

.layout--desktop .sheet-foldout > .unity-foldout__toggle > .unity-toggle__input > .unity-foldout__text {
    font-size: 12px;
    letter-spacing: 3px;
}

.layout--desktop .data-row {
    padding: 6px 0;
    min-height: 40px;
}

.layout--desktop .data-label {
    font-size: 12px;
    width: 112px;
    min-width: 112px;
    max-width: 112px;
    margin-right: 12px;
}

.layout--desktop .data-value {
    font-size: 14px;
    -unity-text-align: upper-left;
}

.layout--desktop .data-value.read-only-text > .unity-text-field__input {
    font-size: 14px;
}

/* ── PART INFO: a small pill, bottom right (mirrors the SHORTCUTS pill at the bottom left) ── */
.layout--desktop .info-bar-peek {
    left: auto;
    right: 24px;
    bottom: 24px;
    width: auto;
    min-width: 148px;
    height: 44px;
    padding: 0 22px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    border-width: 1px;
    border-radius: 22px;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: rgba(0, 0, 0, 0.45);
    translate: 0 0;
    opacity: 1;
    transition-property: translate, opacity, border-color, background-color;
    transition-duration: 0.2s;
}

.layout--desktop .info-bar-peek:hover {
    height: 44px;
    border-color: rgba(70, 175, 255, 1);
    background-color: rgba(70, 175, 255, 0.08);
}

.layout--desktop .info-bar-peek:active {
    height: 44px;
    background-color: rgba(70, 175, 255, 0.16);
}

.layout--desktop .info-bar-peek--visible {
    translate: 0 0;
    opacity: 1;
    visibility: visible;
}

.layout--desktop .info-bar-peek--hidden,
.layout--desktop .info-bar-peek--sheet-open {
    translate: 0 14px;
    opacity: 0;
    visibility: hidden;
}

.layout--desktop .peek-handle {
    display: none;
}

.layout--desktop .peek-label {
    font-size: 13px;
    letter-spacing: 1.5px;
    color: rgba(255, 255, 255, 0.65);
}

.layout--desktop .info-bar-peek:hover .peek-label {
    color: rgba(70, 175, 255, 1);
}

/* Tutorial open: hide the capsule and the header behind the card (it showed through the buttons). */
.desktop-tutorial-open .bottom-bar,
.desktop-tutorial-open .top-bar,
.desktop-tutorial-open .info-bar-peek {
    opacity: 0;
}

.layout--desktop .details-sheet .data-label {
    color: rgba(255, 255, 255, 0.55);
}

/* ════════════════════════════════════════════════════════════════
   Phase 3B — part tree (left docked panel, symmetric to the details panel) and its pill.
   ════════════════════════════════════════════════════════════════ */
.desktop-treepill {
    left: 214px;
}

.desktop-treepill--active {
    left: 24px;
    border-color: rgba(70, 175, 255, 1);
    background-color: rgba(70, 175, 255, 0.10);
}

.desktop-tree {
    position: absolute;
    left: 16px;
    top: 112px;
    bottom: 84px;
    width: 340px;
    padding: 16px 8px 12px 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 24px;
    background-color: rgba(5, 7, 11, 0.98);
    transition-property: translate, opacity;
    transition-duration: 0.3s, 0.25s;
    transition-timing-function: ease-out, ease-out;
}

.desktop-tree--hidden {
    display: none;
}

.desktop-tree-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-right: 8px;
    margin-bottom: 10px;
}

.desktop-tree-title {
    font-size: 16px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.desktop-tree-close {
    width: 32px;
    height: 32px;
    padding: 0;
    margin: 0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 16px;
    background-color: transparent;
    color: rgba(255, 255, 255, 0.7);
    font-size: 13px;
}

.desktop-tree-close:hover {
    border-color: rgba(70, 175, 255, 1);
    color: rgba(70, 175, 255, 1);
}

.desktop-tree-searchbox {
    margin-right: 8px;
    margin-bottom: 6px;
    height: 44px;
}

.desktop-tree .desktop-tree-search {
    margin: 0;
    height: 44px;
}

.desktop-tree .desktop-tree-search > .unity-base-text-field__input {
    height: 44px;
    padding: 0 18px;
    border-radius: 22px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: rgba(255, 255, 255, 0.05);
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-text-align: middle-left;
}

.desktop-tree .desktop-tree-search:focus > .unity-base-text-field__input {
    border-color: rgba(70, 175, 255, 1);
    background-color: rgba(70, 175, 255, 0.08);
}

.desktop-tree-placeholder {
    position: absolute;
    left: 18px;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-left;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.40);
}

.desktop-tree-placeholder--focus {
    color: rgba(255, 255, 255, 0.25);
}

.desktop-tree-count {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.45);
    margin: 4px 8px 8px 6px;
    letter-spacing: 0.5px;
}

.desktop-tree-scroll {
    flex-grow: 1;
    padding-right: 4px;
}

.desktop-tree-row {
    flex-direction: row;
    align-items: center;
    min-height: 36px;
    margin: 0 0 1px 0;
    padding: 4px 8px 4px 10px;
    border-width: 0;
    border-left-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 10px;
    background-color: transparent;
    -unity-text-align: middle-left;
}

.desktop-tree-row:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.desktop-tree-row--cursor {
    background-color: rgba(255, 255, 255, 0.09);
}

.desktop-tree-row--selected {
    border-color: rgba(70, 175, 255, 1);
    background-color: rgba(70, 175, 255, 0.12);
}

.desktop-tree-row--category {
    margin-top: 6px;
}

.desktop-tree-row--category .desktop-tree-rowtitle {
    font-size: 12px;
    letter-spacing: 1.5px;
    color: rgba(255, 255, 255, 0.5);
    -unity-font-style: bold;
}

.desktop-tree-rowtitle {
    flex-shrink: 1;
    flex-grow: 1;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.88);
    white-space: normal;
    -unity-text-align: middle-left;
}

.desktop-tree-row--selected .desktop-tree-rowtitle {
    color: rgba(70, 175, 255, 1);
}

.desktop-tree-row--match .desktop-tree-rowtitle {
    color: rgb(255, 255, 255);
}

.desktop-tree-chevron {
    width: 16px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    -unity-text-align: middle-center;
}

.desktop-tree-row--group .desktop-tree-rowtitle {
    color: rgba(255, 255, 255, 0.62);
}

/* ================================================================
   Phase 4 - desktop chrome (approved mockup docs/unity_pc/maqueta_desktop).
   Root classes: desktop-ui layout--desktop chrome2 (added by DesktopChrome).
   Top bar 44 px, rails 40 px, status bar 26 px; the old capsule and cards become a 36 px tool strip and
   small popovers; the details sheet and the part tree are docked (no margins). 3-class selectors beat the
   2-class rules above (and the .ui-compact ones).
   ================================================================ */
.layout--desktop.chrome2 .top-bar,
.layout--desktop.chrome2 .actions-row,
.layout--desktop.chrome2 .info-bar-peek,
.layout--desktop.chrome2 .info-bar-peek--visible,
.layout--desktop.chrome2 .info-bar-peek--hidden,
.layout--desktop.chrome2 .thermal-legend,
.layout--desktop.chrome2 .desktop-hint {
    display: none;
}

/* top bar */
.dk-top {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 44px;
    flex-direction: row;
    align-items: center;
    padding: 0 10px;
    background-color: rgb(14, 17, 22);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.09);
}

.dk-grow { flex-grow: 1; }

.dk-brand {
    font-size: 14px;
    color: rgb(207, 215, 226);
    margin: 0 0 0 6px;
}

.dk-brand--accent {
    color: rgb(191, 234, 255);
    -unity-font-style: bold;
    margin-left: 4px;
    margin-right: 10px;
}

.dk-crumb {
    height: 28px;
    padding: 0 12px;
    font-size: 13px;
    color: rgb(139, 149, 163);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    border-radius: 14px;
    -unity-text-align: middle-center;
}

.dk-crumb--has {
    color: rgb(191, 234, 255);
    border-color: rgba(70, 175, 255, 0.45);
    background-color: rgba(70, 175, 255, 0.08);
}

.dk-seg {
    flex-direction: row;
    height: 32px;
    padding: 2px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    border-radius: 16px;
    background-color: rgb(23, 27, 34);
}

.dk-seg-btn {
    flex-direction: row;
    align-items: center;
    height: 26px;
    min-height: 0;
    margin: 0 1px;
    padding: 0 12px;
    border-width: 0;
    border-radius: 13px;
    background-color: rgba(0, 0, 0, 0);
}

.dk-seg-btn:hover {
    background-color: rgb(27, 32, 41);
}

.dk-seg-btn--on,
.dk-seg-btn--on:hover {
    background-color: rgba(70, 175, 255, 0.16);
    border-width: 1px;
    border-color: rgba(70, 175, 255, 0.55);
}

.dk-seg-text {
    font-size: 13px;
    color: rgb(139, 149, 163);
}

.dk-seg-btn:hover .dk-seg-text { color: rgb(255, 255, 255); }
.dk-seg-btn--on .dk-seg-text { color: rgb(191, 234, 255); }

.dk-kbd {
    font-size: 11px;
    padding: 1px 5px;
    margin-left: 7px;
    color: rgb(139, 149, 163);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 5px;
    background-color: rgb(11, 13, 17);
}

.dk-ibtn {
    width: 30px;
    height: 30px;
    min-width: 0;
    min-height: 0;
    margin: 0 1px;
    padding: 0;
    border-width: 0;
    border-radius: 15px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(170, 180, 193);
    align-items: center;
    justify-content: center;
}

.dk-ibtn:hover {
    background-color: rgb(27, 32, 41);
    color: rgb(255, 255, 255);
}

.dk-ibtn--on,
.dk-ibtn--on:hover {
    color: rgb(191, 234, 255);
    border-width: 1px;
    border-color: rgba(70, 175, 255, 0.5);
    background-color: rgba(70, 175, 255, 0.08);
}

.dk-ibtn--small { width: 24px; height: 24px; border-radius: 12px; }

.dk-ibtn .dk-icon { color: rgb(170, 180, 193); }
.dk-ibtn:hover .dk-icon { color: rgb(255, 255, 255); }
.dk-ibtn--on .dk-icon { color: rgb(191, 234, 255); }

.dk-sep {
    width: 1px;
    height: 18px;
    margin: 0 6px;
    background-color: rgba(255, 255, 255, 0.09);
}

.dk-lang {
    flex-direction: row;
    padding: 2px;
    margin-right: 2px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    border-radius: 12px;
    background-color: rgb(23, 27, 34);
}

.dk-lang-btn {
    height: 20px;
    min-height: 0;
    margin: 0;
    padding: 0 8px;
    border-width: 0;
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(139, 149, 163);
    font-size: 11px;
}

.dk-lang-btn:hover { color: rgb(255, 255, 255); }
.dk-lang-btn--on, .dk-lang-btn--on:hover { background-color: rgba(70, 175, 255, 0.2); color: rgb(191, 234, 255); }

/* rails (fold to icons) and status bar */
.dk-rail {
    position: absolute;
    top: 44px;
    bottom: 26px;
    width: 40px;
    padding-top: 8px;
    align-items: center;
    background-color: rgb(14, 17, 22);
}

.dk-rail--left { left: 0; border-right-width: 1px; border-right-color: rgba(255, 255, 255, 0.09); }
.dk-rail--right { right: 0; border-left-width: 1px; border-left-color: rgba(255, 255, 255, 0.09); }

.dk-status {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 26px;
    flex-direction: row;
    align-items: center;
    padding: 0 12px;
    background-color: rgb(11, 13, 17);
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.09);
}

.dk-status-text {
    font-size: 12px;
    color: rgb(139, 149, 163);
    margin: 0 14px 0 0;
}

.dk-status-btn {
    flex-direction: row;
    align-items: center;
    height: 20px;
    min-height: 0;
    margin: 0;
    padding: 0 6px;
    border-width: 0;
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0);
}

.dk-status-btn:hover { background-color: rgb(27, 32, 41); }
.dk-status-btn .dk-status-text { margin: 0 0 0 6px; }
.dk-status-btn .dk-kbd { margin-left: 0; }

.dk-tlg { flex-direction: row; align-items: center; margin-right: 14px; }
.dk-tlg .dk-status-text { margin: 0; }
.dk-tlg-bar { width: 150px; height: 8px; margin: 0 8px; border-radius: 4px; }

/* tool strip (the old mode cards) */
.layout--desktop.chrome2 .bottom-bar {
    top: 52px;
    bottom: auto;
    transition-property: left, right;
}

.layout--desktop.chrome2 .mode-container {
    position: relative;
    width: auto;
    max-width: none;
    margin: 0;
    align-self: center;
    align-items: center;
}

.layout--desktop.chrome2 .mode-submenu {
    position: relative;
    width: auto;
    margin: 0;
    padding: 0;
}

.layout--desktop.chrome2 #AnalyzeCardGrid.submenu--hidden {
    display: flex;
    opacity: 1;
    scale: 1 1;
    translate: 0 0;
}

.dk-strip {
    flex-direction: row;
    align-items: center;
    height: 36px;
    padding: 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    border-radius: 18px;
    background-color: rgba(14, 17, 22, 0.90);
}

.layout--desktop.chrome2 .dk-strip > .submenu-title { display: none; }

.layout--desktop.chrome2 .dk-strip > .submenu-grid {
    flex-direction: row;
    flex-wrap: nowrap;
    width: auto;
    padding: 0;
    align-self: center;
}

.layout--desktop.chrome2 .dk-strip .submenu-card {
    width: auto;
    height: 28px;
    margin: 0 1px;
    padding: 0 12px;
    flex-direction: row;
    border-width: 0;
    border-radius: 14px;
    background-color: rgba(0, 0, 0, 0);
}

.layout--desktop.chrome2 .dk-strip .submenu-card:hover { background-color: rgb(27, 32, 41); }

.layout--desktop.chrome2 .dk-strip .submenu-card.submenu-card--active,
.layout--desktop.chrome2 .dk-strip .submenu-card.submenu-card--active:hover {
    border-width: 1px;
    border-color: rgba(70, 175, 255, 0.55);
    background-color: rgba(70, 175, 255, 0.16);
}

.layout--desktop.chrome2 .dk-strip > .submenu-grid .submenu-icon {
    width: 16px;
    min-width: 16px;
    max-width: 16px;
    height: 16px;
    min-height: 16px;
    max-height: 16px;
    margin: 0 6px 0 0;
}

.layout--desktop.chrome2 .dk-strip .submenu-label {
    font-size: 13px;
    letter-spacing: 0;
    color: rgb(182, 192, 204);
    -unity-font-style: normal;
}

.layout--desktop.chrome2 .dk-strip .submenu-card--active .submenu-label { color: rgb(191, 234, 255); }

.dk-strip-btn {
    flex-direction: row;
    align-items: center;
    height: 28px;
    min-height: 0;
    margin: 0 1px;
    padding: 0 12px;
    border-width: 0;
    border-radius: 14px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(182, 192, 204);
}

.dk-strip-btn:hover { background-color: rgb(27, 32, 41); color: rgb(255, 255, 255); }
.dk-strip-btn--on, .dk-strip-btn--on:hover {
    border-width: 1px;
    border-color: rgba(70, 175, 255, 0.55);
    background-color: rgba(70, 175, 255, 0.16);
    color: rgb(191, 234, 255);
}

.dk-strip-text { font-size: 13px; margin-left: 6px; margin-right: 0; color: rgb(182, 192, 204); }
.dk-strip-btn--on .dk-strip-text { color: rgb(191, 234, 255); }
.dk-strip-btn .dk-icon { color: rgb(182, 192, 204); }
.dk-strip-btn--on .dk-icon { color: rgb(191, 234, 255); }

/* popovers (CUT, FILTER, EXPLODE, POWER, RENDER / ENVIRONMENT, settings) */
.layout--desktop.chrome2 .dk-pop {
    position: absolute;
    top: 44px;
    left: 50%;
    translate: -50% 0;
    scale: 1 1;
    width: 300px;
    margin: 0;
    padding: 10px 12px 12px 12px;
    flex-direction: column;
    align-items: stretch;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.11);
    border-radius: 14px;
    background-color: rgb(18, 21, 27);
}

.layout--desktop.chrome2 .dk-pop--studio { width: 320px; }

.dk-pop .submenu-title {
    font-size: 13px;
    letter-spacing: 0.5px;
    margin: 0 0 8px 0;
    color: rgb(232, 237, 243);
    -unity-text-align: middle-left;
    align-self: flex-start;
}

.dk-pop .submenu-title--section { margin-top: 0; }

.dk-pop .submenu-back-btn {
    left: auto;
    right: 8px;
    top: 6px;
    width: 24px;
    height: 24px;
    min-width: 0;
    min-height: 0;
    padding: 0;
    font-size: 12px;
    border-radius: 12px;
}

.dk-pop .submenu-grid {
    width: auto;
    padding: 0;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-self: stretch;
}

.dk-pop .submenu-card {
    width: 31.5%;
    height: 28px;
    margin: 2px 0.4%;
    padding: 0 6px;
    flex-direction: row;
    border-radius: 14px;
}

.dk-pop .submenu-card:hover { border-color: rgba(70, 175, 255, 0.4); }
.dk-pop .submenu-icon { display: none; }
.dk-pop .submenu-label { font-size: 12px; letter-spacing: 0; color: rgb(201, 210, 221); }
.dk-pop .submenu-card--active .submenu-label { color: rgb(191, 234, 255); -unity-font-style: normal; }
.dk-pop .env-cycle-dots { display: none; }

.dk-pop .cross-section-control-row { max-width: none; padding: 0; margin-bottom: 8px; }
.dk-pop .cross-section-axis-group { gap: 6px; }
.dk-pop .cross-section-axis-btn { height: 28px; border-radius: 14px; }
.dk-pop .cross-section-axis-label { font-size: 13px; }
.dk-pop .cross-section-plane-group { max-width: none; }
.dk-pop .cross-section-plane-caption { padding: 0; margin-bottom: 2px; font-size: 10px; letter-spacing: 1px; }
.dk-pop .cross-section-slider-row { max-width: none; padding: 0; }
.dk-pop .cross-section-slider { height: 28px; min-height: 28px; padding: 0 4px; }
.dk-pop .cross-section-config-btn { width: 28px; min-width: 28px; height: 28px; min-height: 28px; border-radius: 14px; }
.dk-pop .cross-section-config-icon { width: 16px; min-width: 16px; max-width: 16px; height: 16px; min-height: 16px; max-height: 16px; }
.dk-pop .glass-slider { min-height: 28px; }
.dk-pop .glass-slider .unity-base-slider__dragger { width: 14px; height: 14px; margin-top: -7px; border-width: 2px; }
.dk-pop .glass-slider .unity-base-slider__dragger:hover { width: 16px; height: 16px; margin-top: -8px; }

.layout--desktop.chrome2 .explode-inline-slider.dk-pop { width: 260px; flex-direction: row; align-items: center; margin-top: 0; padding: 4px 12px; }
.dk-pop .explosion-value-label { font-size: 12px; min-width: 36px; }

.layout--desktop.chrome2 .inspect-power-panel.dk-pop { width: 280px; min-height: 0; }
.dk-pop .inspect-power-header { margin-bottom: 4px; }
.dk-pop .inspect-power-state { font-size: 12px; }
.dk-pop .inspect-power-value { font-size: 12px; }

.dk-pop .env-slider-group { width: auto; height: 28px; margin: 2px 0 0 0; padding: 0; align-self: stretch; }
.dk-pop .env-slider-label { font-size: 11px; width: 132px; min-width: 132px; max-width: 132px; margin-right: 8px; letter-spacing: 0; white-space: normal; -unity-text-align: middle-left; flex-shrink: 0; }
.dk-pop .env-slider { min-height: 28px; flex-grow: 1; flex-basis: 0; min-width: 0; }

.dk-studio--render #EnvGrid,
.dk-studio--render .env-slider-group,
.dk-studio--render .submenu-title--section { display: none; }
.dk-studio--env #ShaderMenu { display: none; }
.dk-studio--env #DkTitleRender { display: none; }
.layout--desktop.chrome2 .dk-studio--none { display: none; }

.dk-pop-head { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 6px; }
.dk-pop-title { font-size: 13px; color: rgb(232, 237, 243); -unity-font-style: bold; }

.layout--desktop.chrome2 .dk-settings {
    top: 48px;
    left: auto;
    right: 8px;
    bottom: 34px;
    translate: 0 0;
    width: 420px;
}

.layout--desktop.chrome2 .dk-settings--hidden { display: none; }
.dk-settings-body { flex-grow: 1; flex-shrink: 1; min-height: 0; }

.layout--desktop.chrome2 .dk-config-embedded {
    position: relative;
    left: auto;
    top: auto;
    right: auto;
    bottom: auto;
    width: 100%;
    height: auto;
    flex-grow: 1;
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
    display: flex;
    align-items: stretch;
    justify-content: flex-start;
    background-color: rgba(0, 0, 0, 0);
}

.dk-config-embedded #SubmenuBackBtn_Config { display: none; }

/* docked inspector (the old bottom sheet) */
.layout--desktop.chrome2 .details-sheet {
    top: 44px;
    bottom: 26px;
    right: 0;
    padding: 0;
    border-width: 0;
    border-left-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    border-radius: 0;
    background-color: rgb(14, 17, 22);
}

.layout--desktop.chrome2 .sheet-header { padding: 10px 44px 4px 14px; margin-bottom: 0; }
.layout--desktop.chrome2 .sheet-title { font-size: 15px; letter-spacing: 0; }
.layout--desktop.chrome2 .sheet-close-btn { top: 8px; right: 10px; width: 24px; height: 24px; border-radius: 12px; }
.layout--desktop.chrome2 .sheet-close-icon { width: 12px; min-width: 12px; max-width: 12px; height: 12px; min-height: 12px; max-height: 12px; }
.layout--desktop.chrome2 .sheet-scroll { margin-top: 0; padding: 0 6px 0 14px; }
.layout--desktop.chrome2 .sheet-description { font-size: 13px; margin-bottom: 8px; color: rgba(255, 255, 255, 0.7); }
.layout--desktop.chrome2 .sheet-foldout > .unity-foldout__toggle > .unity-toggle__input > .unity-foldout__text { font-size: 12px; letter-spacing: 1.5px; }
.layout--desktop.chrome2 .data-row { padding: 3px 0; min-height: 28px; }
.layout--desktop.chrome2 .data-label { font-size: 11px; width: 96px; min-width: 96px; max-width: 96px; margin-right: 8px; }
.layout--desktop.chrome2 .data-value { font-size: 13px; }
.layout--desktop.chrome2 .data-value.read-only-text > .unity-text-field__input { font-size: 13px; }

.dk-sheet-footer {
    flex-direction: row;
    flex-shrink: 0;
    padding: 10px 12px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.09);
}

.dk-btn {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    height: 28px;
    min-height: 0;
    margin: 0 4px;
    padding: 0 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    border-radius: 14px;
    background-color: rgb(23, 27, 34);
    color: rgb(201, 210, 221);
}

.dk-btn:hover { border-color: rgba(70, 175, 255, 0.5); color: rgb(255, 255, 255); }
.dk-btn .dk-icon { color: rgb(201, 210, 221); }
.dk-btn-text { font-size: 12px; margin: 0 4px 0 6px; color: rgb(201, 210, 221); }

/* docked parts tree */
.layout--desktop.chrome2 .desktop-tree {
    left: 0;
    top: 44px;
    bottom: 26px;
    width: 280px;
    padding: 6px 4px 8px 10px;
    border-width: 0;
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.09);
    border-radius: 0;
    background-color: rgb(14, 17, 22);
}

.layout--desktop.chrome2 .desktop-tree-title { font-size: 14px; letter-spacing: 0; }
.layout--desktop.chrome2 .desktop-tree-close { width: 24px; height: 24px; border-radius: 12px; }
.layout--desktop.chrome2 .desktop-tree-searchbox { height: 30px; }
.layout--desktop.chrome2 .desktop-tree .desktop-tree-search { height: 30px; }
.layout--desktop.chrome2 .desktop-tree .desktop-tree-search > .unity-base-text-field__input { height: 30px; padding: 0 12px; border-radius: 15px; font-size: 13px; }
.layout--desktop.chrome2 .desktop-tree-placeholder { left: 12px; font-size: 13px; }
.layout--desktop.chrome2 .desktop-tree-row { min-height: 28px; padding: 2px 6px 2px 8px; border-radius: 8px; }
.layout--desktop.chrome2 .desktop-tree-rowtitle { font-size: 13px; }
.layout--desktop.chrome2 .desktop-tree-row--category .desktop-tree-rowtitle { font-size: 11px; }
.layout--desktop.chrome2 .desktop-tree-row--selected,
.layout--desktop.chrome2 .desktop-tree-row--selected:hover {
    border-color: rgba(191, 234, 255, 0.6);
    background-color: rgba(70, 175, 255, 0.16);
}

/* help overlay as a popover (top right), not a full-screen sheet */
.layout--desktop.chrome2 .desktop-help {
    align-items: flex-end;
    justify-content: flex-start;
    padding: 50px 10px 34px 10px;
    background-color: rgba(0, 0, 0, 0.25);
}

.layout--desktop.chrome2 .desktop-help-card {
    width: 760px;
    max-width: 96%;
    padding: 14px 22px 12px 22px;
    border-radius: 14px;
    background-color: rgb(18, 21, 27);
    border-color: rgba(255, 255, 255, 0.11);
}

.layout--desktop.chrome2 .desktop-help-title { font-size: 15px; letter-spacing: 1px; -unity-text-align: middle-left; }
.layout--desktop.chrome2 .desktop-help-subtitle { font-size: 12px; -unity-text-align: middle-left; margin-bottom: 4px; }
.layout--desktop.chrome2 .desktop-help-row { min-height: 26px; }
.layout--desktop.chrome2 .desktop-help-desc { font-size: 13px; }
.layout--desktop.chrome2 .desktop-help-section { font-size: 11px; margin-top: 6px; }
.layout--desktop.chrome2 .desktop-help-footer { margin-top: 8px; }

/* settings popover (CONFIG inside the viewer): own base rules (not .dk-pop, whose slider rules are for the tool popovers) */
.layout--desktop.chrome2 .dk-settings {
    position: absolute;
    padding: 10px 12px 12px 12px;
    flex-direction: column;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.11);
    border-radius: 14px;
    background-color: rgb(18, 21, 27);
}

.dk-config-embedded > .hero-title { display: none; }
.dk-config-embedded .submenu-scroll { max-width: none; max-height: none; width: 100%; padding: 0; align-self: stretch; flex-grow: 1; overflow: hidden; }
.dk-config-embedded .config-section-label { -unity-text-align: middle-left; font-size: 11px; margin: 10px 0 6px 0; }
.dk-config-embedded .config-tier-auto { width: 100%; height: 28px; font-size: 12px; border-radius: 14px; }
.dk-config-embedded .config-tier-row { max-width: none; margin-bottom: 8px; }
.dk-config-embedded .config-tier-card { height: 28px; min-height: 0; border-radius: 14px; font-size: 11px; }
.dk-config-embedded .config-advanced-section { max-width: none; padding: 6px 10px; align-self: stretch; }
.dk-config-embedded .config-row { margin-top: 2px; margin-bottom: 2px; min-height: 30px; }
.dk-config-embedded .config-row-label { font-size: 12px; }
.dk-config-embedded .config-cycle-btn { min-width: 96px; height: 28px; min-height: 0; font-size: 12px; border-radius: 14px; }
.dk-config-embedded .desktop-display-section { max-width: none; margin-bottom: 8px; padding: 6px 10px; align-self: stretch; }
.dk-config-embedded .env-slider-label { font-size: 11px; letter-spacing: 0.5px; }
.dk-config-embedded .env-slider-group,
.dk-config-embedded .desktop-display-section .env-slider-group { height: auto; min-height: 44px; }

/* polish: aligned label column in every slider row, wrapped instead of overlapped by the thumb */
.dk-config-embedded .env-slider-label { white-space: normal; -unity-text-align: middle-left; letter-spacing: 0; }
.dk-config-embedded .config-advanced-section .env-slider-group { flex-direction: row; align-items: center; }
.dk-config-embedded .config-advanced-section .env-slider-label { width: 118px; min-width: 118px; max-width: 118px; flex-shrink: 0; margin-right: 8px; }
.dk-config-embedded .config-advanced-section .env-slider { flex-grow: 1; flex-basis: 0; min-width: 0; }
.dk-config-embedded .desktop-display-section .env-slider-group { flex-direction: column; align-items: stretch; }
.dk-pop .cross-section-plane-caption { white-space: normal; }

/* inspector rhythm: even gaps, first foldout open by default (set from DesktopChrome) */
.layout--desktop.chrome2 .sheet-description { margin-top: 2px; margin-bottom: 12px; padding-bottom: 10px; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.08); }
.layout--desktop.chrome2 .sheet-foldout { margin-top: 0; margin-bottom: 0; }
.layout--desktop.chrome2 .sheet-scroll .unity-foldout__content { padding-bottom: 6px; }

.layout--desktop.chrome2 .data-label { white-space: normal; width: 104px; min-width: 104px; max-width: 104px; -unity-text-align: upper-left; }
.layout--desktop.chrome2 .data-row { align-items: flex-start; }

/* ================================================================
   Phase 5 - icon set + button system (approved sheet docs/unity_pc/maqueta_iconos), PC only.
   Tokens: celeste rgb(70,175,255), light celeste rgb(191,234,255), panel rgb(23,27,34), hover rgb(27,32,41).
   Variants: primary (filled light celeste, dark text), secondary, ghost, icon, pill, segmented (.dk-seg), toggle.
   States: normal, hover, pressed (:active), focus (ring after Tab, .dk-keynav), active (--on: celeste 16 %), disabled (40 %).
   Desktop density: 28-32 px controls, 13-14 px text; hero / tutorial primary buttons 36-40 px.
   ================================================================ */

.desktop-ui .dk-b {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 30px;
    min-height: 0;
    margin: 0;
    padding: 0 14px;
    border-width: 1px;
    border-radius: 15px;
    border-color: rgba(255, 255, 255, 0.09);
    background-color: rgb(23, 27, 34);
    color: rgb(219, 228, 238);
    font-size: 13px;
    letter-spacing: 0;
    -unity-font-style: normal;
    scale: 1 1;
    transition-property: background-color, border-color, color;
    transition-duration: 0.1s;
}

.desktop-ui .dk-b:hover {
    background-color: rgb(27, 32, 41);
    border-color: rgba(70, 175, 255, 0.5);
    color: rgb(255, 255, 255);
    scale: 1 1;
}

.desktop-ui .dk-b:active {
    background-color: rgba(70, 175, 255, 0.22);
    border-color: rgba(70, 175, 255, 0.7);
    color: rgb(191, 234, 255);
    scale: 1 1;
}

.desktop-ui .dk-b--on,
.desktop-ui .dk-b--on:hover {
    background-color: rgba(70, 175, 255, 0.16);
    border-color: rgba(70, 175, 255, 0.55);
    color: rgb(191, 234, 255);
}

.desktop-ui .dk-b:disabled { opacity: 0.4; }

.desktop-ui .dk-b--primary {
    background-color: rgb(191, 234, 255);
    border-color: rgb(191, 234, 255);
    color: rgb(6, 34, 47);
    -unity-font-style: bold;
}

.desktop-ui .dk-b--primary:hover {
    background-color: rgb(255, 255, 255);
    border-color: rgb(255, 255, 255);
    color: rgb(6, 34, 47);
}

.desktop-ui .dk-b--primary:active {
    background-color: rgb(143, 208, 242);
    border-color: rgb(143, 208, 242);
    color: rgb(6, 34, 47);
}

.desktop-ui .dk-b--secondary { background-color: rgb(23, 27, 34); }

.desktop-ui .dk-b--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    color: rgb(170, 180, 193);
}

.desktop-ui .dk-b--ghost:hover { background-color: rgb(27, 32, 41); border-color: rgba(0, 0, 0, 0); color: rgb(255, 255, 255); }

.desktop-ui .dk-b--icon { width: 30px; padding: 0; background-color: rgba(0, 0, 0, 0); border-color: rgba(0, 0, 0, 0); color: rgb(170, 180, 193); }
.desktop-ui .dk-b--icon:hover { background-color: rgb(27, 32, 41); border-color: rgba(70, 175, 255, 0.25); color: rgb(255, 255, 255); }
.desktop-ui .dk-b--icon:active { background-color: rgba(70, 175, 255, 0.22); border-color: rgba(70, 175, 255, 0.7); color: rgb(191, 234, 255); }

.desktop-ui .dk-b--pill { height: 26px; padding: 0 12px; font-size: 12.5px; border-radius: 13px; background-color: rgba(0, 0, 0, 0); border-color: rgba(255, 255, 255, 0.16); color: rgb(182, 192, 204); }

.desktop-ui .dk-b--lg { height: 40px; padding: 0 22px; border-radius: 20px; font-size: 14px; }

.dk-keynav .dk-b:focus,
.dk-keynav .dk-ibtn:focus,
.dk-keynav .dk-seg-btn:focus,
.dk-keynav .dk-strip-btn:focus,
.dk-keynav .dk-lang-btn:focus,
.dk-keynav .dk-status-btn:focus,
.dk-keynav .submenu-card:focus,
.dk-keynav .desktop-tree-row:focus,
.dk-keynav .desktop-tree-close:focus,
.dk-keynav .config-cycle-btn:focus,
.dk-keynav .config-tier-card:focus,
.dk-keynav .cross-section-axis-btn:focus,
.dk-keynav .dk-tut-switch-btn:focus {
    border-width: 2px;
    border-color: rgb(70, 175, 255);
}

.dk-b-text { margin: 0 4px; font-size: 13px; }
.dk-b .dk-icon { color: rgb(170, 180, 193); }
.dk-b:hover .dk-icon { color: rgb(255, 255, 255); }
.dk-b:active .dk-icon, .dk-b--on .dk-icon { color: rgb(191, 234, 255); }
.dk-b--primary .dk-icon, .dk-b--primary:hover .dk-icon, .dk-b--primary:active .dk-icon { color: rgb(6, 34, 47); }
.dk-b .dk-kbd { margin-left: 6px; }
.dk-kbd--on-primary { color: rgb(6, 34, 47); border-color: rgba(6, 34, 47, 0.35); background-color: rgba(6, 34, 47, 0.06); }

/* hero buttons (PC) */
.desktop-ui .dk-b--lg.btn-wide { width: 260px; max-width: 260px; height: 40px; margin-bottom: 12px; align-self: center; }
.desktop-ui .dk-b--lg .dk-b-lead { position: absolute; left: 16px; top: 10px; }
.desktop-ui .dk-b--lg.dk-b--lead { padding-left: 50px; padding-right: 22px; }
.desktop-ui .dk-b--lg.dk-b--ghost.about-tool-btn { width: 220px; height: 32px; opacity: 1; font-size: 13px; margin-bottom: 8px; }
.desktop-ui .hero-info-btn.dk-b { width: 40px; height: 40px; border-radius: 20px; margin-right: 12px; background-color: rgb(23, 27, 34); border-color: rgba(255, 255, 255, 0.09); }
.desktop-ui .hero-info-btn.dk-b:hover { background-color: rgb(27, 32, 41); border-color: rgba(70, 175, 255, 0.5); }
.desktop-ui .dk-b--hero-back { position: absolute; top: 24px; left: 24px; width: 40px; height: 40px; border-radius: 20px; }
.desktop-ui .dk-b--primary.btn-start { padding: 0 22px; }

/* pressed / disabled for the controls that predate the system (same celeste language) */
.dk-ibtn:active,
.dk-seg-btn:active,
.dk-strip-btn:active,
.dk-lang-btn:active,
.dk-btn:active,
.dk-status-btn:active {
    background-color: rgba(70, 175, 255, 0.22);
    border-color: rgba(70, 175, 255, 0.7);
    color: rgb(191, 234, 255);
}

.layout--desktop.chrome2 .dk-strip .submenu-card:active,
.layout--desktop.chrome2 .dk-pop .submenu-card:active,
.layout--desktop.chrome2 .dk-pop .cross-section-axis-btn:active,
.layout--desktop.chrome2 .dk-pop .cross-section-config-btn:active {
    background-color: rgba(70, 175, 255, 0.22);
    border-color: rgba(70, 175, 255, 0.7);
}

.desktop-tree-row:active { background-color: rgba(70, 175, 255, 0.22); }
.dk-ibtn:disabled, .dk-seg-btn:disabled, .dk-strip-btn:disabled, .dk-btn:disabled, .submenu-card:disabled { opacity: 0.4; }
.dk-ibtn:active .dk-icon, .dk-strip-btn:active .dk-icon, .dk-btn:active .dk-icon, .dk-seg-btn:active .dk-icon { color: rgb(191, 234, 255); }
.dk-btn:hover .dk-icon { color: rgb(255, 255, 255); }

/* top bar: segmented switch with icons, language icon */
.dk-seg-btn .dk-icon { margin-right: 6px; color: rgb(139, 149, 163); }
.dk-seg-btn:hover .dk-icon { color: rgb(255, 255, 255); }
.dk-seg-btn--on .dk-icon, .dk-seg-btn--on:hover .dk-icon { color: rgb(191, 234, 255); }
.dk-lang { align-items: center; }
.dk-lang-icon { margin: 0 4px 0 6px; color: rgb(139, 149, 163); }
.dk-ibtn--small { width: 28px; height: 28px; border-radius: 14px; }

/* cards: vector icons replace the procedural ones (tool strip and popovers) */
.layout--desktop.chrome2 .dk-pop .submenu-icon { display: flex; width: 16px; min-width: 16px; max-width: 16px; height: 16px; min-height: 16px; max-height: 16px; margin: 0 6px 0 0; }
.layout--desktop .submenu-card .outline-icon { color: rgb(182, 192, 204); }
.layout--desktop .submenu-card:hover .outline-icon { color: rgb(255, 255, 255); }
.layout--desktop .submenu-card--active .outline-icon, .layout--desktop .submenu-card--active:hover .outline-icon, .layout--desktop .submenu-card:active .outline-icon { color: rgb(191, 234, 255); }

.layout--desktop.chrome2 .dk-pop .submenu-card { width: 48.6%; margin: 2px 0.4%; padding: 0 10px; justify-content: flex-start; align-items: center; }
.layout--desktop.chrome2 .dk-pop #EnvGrid .submenu-card { width: 31.5%; padding: 0 8px; }
.layout--desktop.chrome2 .dk-pop--studio { width: 340px; }
.layout--desktop.chrome2 .dk-pop .submenu-card--active { background-color: rgba(70, 175, 255, 0.16); border-color: rgba(70, 175, 255, 0.55); }

/* popover close, inspector close, tree close, help close: one icon, one button */
.dk-pop .submenu-back-btn,
.layout--desktop.chrome2 .sheet-close-btn,
.layout--desktop.chrome2 .desktop-tree-close {
    align-items: center;
    justify-content: center;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(170, 180, 193);
}

.dk-pop .submenu-back-btn:hover,
.layout--desktop.chrome2 .sheet-close-btn:hover,
.layout--desktop.chrome2 .desktop-tree-close:hover { background-color: rgb(27, 32, 41); }

.dk-pop .submenu-back-btn .dk-icon,
.layout--desktop.chrome2 .sheet-close-btn .dk-icon,
.layout--desktop.chrome2 .desktop-tree-close .dk-icon { color: rgb(170, 180, 193); }

.dk-pop .submenu-back-btn:hover .dk-icon,
.layout--desktop.chrome2 .sheet-close-btn:hover .dk-icon,
.layout--desktop.chrome2 .desktop-tree-close:hover .dk-icon { color: rgb(255, 255, 255); }

.dk-pop .submenu-back-btn { width: 28px; height: 28px; border-radius: 14px; top: 4px; right: 6px; }
.layout--desktop.chrome2 .sheet-close-btn { width: 28px; height: 28px; border-radius: 14px; top: 6px; right: 8px; }
.layout--desktop.chrome2 .sheet-close-icon { width: 16px; min-width: 16px; max-width: 16px; height: 16px; min-height: 16px; max-height: 16px; }
.dk-pop .outline-icon.back-icon { width: 16px; height: 16px; }
.layout--desktop.chrome2 .desktop-tree-close { width: 28px; height: 28px; border-radius: 14px; }

.dk-pop .cross-section-config-icon { width: 16px; min-width: 16px; max-width: 16px; height: 16px; min-height: 16px; max-height: 16px; }
.dk-pop .cross-section-config-btn { align-items: center; justify-content: center; }
.dk-pop .cross-section-config-btn .dk-icon { color: rgb(182, 192, 204); }
.dk-pop .cross-section-config-btn:hover .dk-icon { color: rgb(255, 255, 255); }

/* tree chevron */
.desktop-tree-chevron { width: 16px; height: 16px; margin-right: 2px; color: rgb(139, 149, 163); }
.desktop-tree-chevron--open { rotate: 90deg; }

/* help overlay head */
.desktop-help-head { flex-direction: row; align-items: center; margin-bottom: 2px; }
.desktop-help-head .dk-icon { color: rgb(191, 234, 255); margin-right: 8px; }
.layout--desktop.chrome2 .desktop-help-head .desktop-help-title { flex-grow: 1; margin-bottom: 0; }
.desktop-help-close { margin-left: auto; }
.desktop-help-close .dk-icon { color: rgb(170, 180, 193); margin-right: 0; }

/* settings (CONFIG) controls with the button system */
.dk-config-embedded .config-cycle-btn,
.dk-config-embedded .config-tier-card,
.dk-config-embedded .config-tier-auto {
    background-color: rgb(23, 27, 34);
    border-color: rgba(255, 255, 255, 0.09);
    color: rgb(219, 228, 238);
    letter-spacing: 0;
    padding: 0 12px;
}

.dk-config-embedded .config-cycle-btn:hover,
.dk-config-embedded .config-tier-card:hover,
.dk-config-embedded .config-tier-auto:hover { background-color: rgb(27, 32, 41); border-color: rgba(70, 175, 255, 0.5); color: rgb(255, 255, 255); }

.dk-config-embedded .config-cycle-btn:active,
.dk-config-embedded .config-tier-card:active,
.dk-config-embedded .config-tier-auto:active { background-color: rgba(70, 175, 255, 0.22); border-color: rgba(70, 175, 255, 0.7); color: rgb(191, 234, 255); }

/* ================================================================
   Tutorial (6 steps): centred card, progress bar, key caps, Atras / Siguiente / Omitir, Left Right Esc.
   ================================================================ */
.dk-tut {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 7, 10, 0.72);
}

.dk-tut--hidden { display: none; }

.dk-tut-card {
    width: 800px;
    max-width: 94%;
    padding: 18px 28px 22px 28px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.11);
    border-radius: 24px;
    background-color: rgb(18, 21, 27);
}

.dk-tut-top { flex-direction: row; align-items: center; }
.dk-tut-counter { font-size: 14px; color: rgb(191, 234, 255); letter-spacing: 1px; min-width: 62px; margin-right: 12px; }
.dk-tut-progress { flex-direction: row; flex-grow: 1; margin-right: 14px; }
.dk-tut-seg { flex-grow: 1; flex-basis: 0; height: 3px; margin-right: 5px; border-radius: 2px; background-color: rgb(42, 48, 58); }
.dk-tut-seg--done { background-color: rgba(70, 175, 255, 0.5); }
.dk-tut-seg--cur { background-color: rgb(70, 175, 255); }

.dk-tut-switch {
    flex-direction: row;
    padding: 2px;
    margin-right: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    border-radius: 15px;
    background-color: rgb(23, 27, 34);
}

.dk-tut-switch-btn {
    height: 24px;
    min-height: 0;
    margin: 0;
    padding: 0 12px;
    border-width: 0;
    border-radius: 12px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(139, 149, 163);
    font-size: 12px;
}

.dk-tut-switch-btn:hover { color: rgb(255, 255, 255); background-color: rgb(27, 32, 41); }
.dk-tut-switch-btn:active { background-color: rgba(70, 175, 255, 0.22); color: rgb(191, 234, 255); }
.dk-tut-switch-btn--on, .dk-tut-switch-btn--on:hover { background-color: rgba(70, 175, 255, 0.16); border-width: 1px; border-color: rgba(70, 175, 255, 0.55); color: rgb(191, 234, 255); }

.dk-tut-body { flex-direction: row; align-items: center; margin: 22px 0 22px 0; }

.dk-tut-art {
    width: 210px;
    height: 230px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    border-radius: 20px;
    background-color: rgb(14, 17, 22);
}

.dk-tut-orbit { position: absolute; left: 28px; top: 38px; right: 28px; bottom: 38px; border-width: 1px; border-color: rgba(255, 255, 255, 0.14); border-radius: 100px; }
.dk-tut-ring { width: 92px; height: 92px; align-items: center; justify-content: center; border-width: 1.5px; border-color: rgba(70, 175, 255, 0.6); border-radius: 46px; background-color: rgba(70, 175, 255, 0.08); }
.dk-tut-bigicon { color: rgb(191, 234, 255); }
.dk-tut-text { flex-grow: 1; flex-shrink: 1; flex-basis: 0; margin-left: 28px; }
.dk-tut-title { font-size: 30px; color: rgb(255, 255, 255); -unity-font-style: bold; margin-bottom: 2px; }
.dk-tut-desc { font-size: 15px; color: rgb(139, 149, 163); white-space: normal; margin-bottom: 14px; }

.dk-tut-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    margin-bottom: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    border-radius: 16px;
    background-color: rgb(14, 17, 22);
}

.dk-tut-bubble { width: 32px; height: 32px; align-items: center; justify-content: center; border-width: 1px; border-color: rgba(70, 175, 255, 0.4); border-radius: 16px; background-color: rgba(70, 175, 255, 0.08); }
.dk-tut-bubble .dk-icon { color: rgb(191, 234, 255); }
.dk-tut-rowname { width: 150px; margin-left: 12px; font-size: 14px; color: rgb(232, 237, 243); -unity-font-style: bold; }
.dk-tut-keys { flex-direction: row; flex-grow: 1; flex-shrink: 1; flex-wrap: wrap; justify-content: flex-end; }
.dk-tut-cap { margin: 1px 0 1px 6px; padding: 2px 8px; font-size: 12px; color: rgb(191, 234, 255); border-width: 1px; border-color: rgba(255, 255, 255, 0.14); border-radius: 6px; background-color: rgb(11, 13, 17); }

.dk-tut-foot { flex-direction: row; align-items: center; }
.dk-tut-foot .dk-b { height: 36px; padding: 0 18px; border-radius: 18px; font-size: 14px; }
.dk-tut-foot .dk-b-text { font-size: 14px; }
.dk-tut-top .dk-b { height: 28px; padding: 0 10px; }

/* polish found while verifying phase 5: help key caps wrap instead of overlapping the description; tier row fits the popover */
.layout--desktop.chrome2 .desktop-help-keys { flex-wrap: wrap; }
.layout--desktop.chrome2 .desktop-help-column--narrow .desktop-help-keys { width: 130px; }
.dk-config-embedded .config-tier-row { flex-wrap: nowrap; }
.dk-config-embedded .config-tier-card { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; width: auto; margin: 0 3px; padding: 0 4px; }
.dk-config-embedded .config-cycle-btn { min-width: 0; flex-shrink: 1; }

/* ================================================================
   Phase 6 - micro-interactions (PC only). 120-200 ms, ease-out, no bounce.
   Hover: tint + slight lift/scale; press: scale .96 + 16 % celeste flash; active changes animate; popovers fade + 6 px slide;
   mode / language pills slide; chevrons rotate; hero and tutorial enter. The code-driven part is in DesktopMotion.cs
   (speed constant, Reduce animations). .dk-reduce-motion on the root zeroes every duration below.
   ================================================================ */
.dk-ibtn,
.dk-seg-btn,
.dk-strip-btn,
.dk-btn,
.dk-lang-btn,
.dk-status-btn,
.desktop-ui .dk-b,
.layout--desktop.chrome2 .dk-strip .submenu-card,
.layout--desktop.chrome2 .dk-pop .submenu-card,
.layout--desktop.chrome2 .dk-pop .cross-section-axis-btn,
.layout--desktop.chrome2 .dk-pop .cross-section-config-btn,
.desktop-tree-close,
.dk-tut-switch-btn,
.dk-config-embedded .config-cycle-btn,
.dk-config-embedded .config-tier-card,
.dk-config-embedded .config-tier-auto,
.layout--desktop.chrome2 .sheet-close-btn,
.dk-pop .submenu-back-btn {
    transition-property: background-color, border-color, color, scale, translate, opacity;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.dk-ibtn:hover, .dk-lang-btn:hover, .dk-status-btn:hover, .dk-pop .submenu-back-btn:hover, .layout--desktop.chrome2 .sheet-close-btn:hover, .desktop-tree-close:hover { scale: 1.07 1.07; }
.dk-seg-btn:hover, .dk-strip-btn:hover, .dk-btn:hover, .desktop-ui .dk-b:hover, .layout--desktop.chrome2 .dk-strip .submenu-card:hover, .layout--desktop.chrome2 .dk-pop .submenu-card:hover, .dk-config-embedded .config-cycle-btn:hover, .dk-config-embedded .config-tier-card:hover { scale: 1.03 1.03; translate: 0 -1px; }
.dk-ibtn:active,
.dk-seg-btn:active,
.dk-strip-btn:active,
.dk-btn:active,
.dk-lang-btn:active,
.dk-status-btn:active,
.desktop-ui .dk-b:active,
.layout--desktop.chrome2 .dk-strip .submenu-card:active,
.layout--desktop.chrome2 .dk-pop .submenu-card:active,
.layout--desktop.chrome2 .dk-pop .cross-section-axis-btn:active,
.layout--desktop.chrome2 .dk-pop .cross-section-config-btn:active,
.desktop-tree-close:active,
.dk-tut-switch-btn:active,
.dk-config-embedded .config-cycle-btn:active,
.dk-config-embedded .config-tier-card:active,
.dk-config-embedded .config-tier-auto:active,
.layout--desktop.chrome2 .sheet-close-btn:active,
.dk-pop .submenu-back-btn:active { scale: 0.96 0.96; translate: 0 0; }

.dk-seg, .dk-lang { position: relative; }
.dk-seg-btn--on, .dk-seg-btn--on:hover { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.dk-lang-btn--on, .dk-lang-btn--on:hover { background-color: rgba(0, 0, 0, 0); }
.dk-pill { position: absolute; left: 0; width: 0; opacity: 0; transition-property: left, width, opacity; transition-duration: 0.2s; transition-timing-function: ease-out; }
.dk-seg-pill { border-radius: 13px; background-color: rgba(70, 175, 255, 0.16); border-width: 1px; border-color: rgba(70, 175, 255, 0.55); }
.dk-lang-pill { border-radius: 10px; background-color: rgba(70, 175, 255, 0.22); }
.dk-notrans, .desktop-ui .dk-notrans, .layout--desktop.chrome2 .dk-notrans, .layout--desktop.chrome2 .dk-pop.dk-notrans, .layout--desktop.chrome2 .dk-settings.dk-notrans, .desktop-ui .dk-b.dk-notrans, .dk-pill.dk-notrans { transition-duration: 0s; }
.dk-enter { opacity: 0; translate: 0 12px; }
.layout--desktop.chrome2 .dk-pop.dk-enter { opacity: 0; translate: -50% 6px; }
.layout--desktop.chrome2 .dk-settings.dk-enter { opacity: 0; translate: 0 6px; }
.layout--desktop.chrome2 .desktop-tree.dk-enter { opacity: 0; translate: -24px 0; }
.layout--desktop.chrome2 .sheet-title.dk-enter { opacity: 0; translate: 10px 0; }
.dk-tut-card.dk-enter { opacity: 0; translate: 0 14px; scale: 0.98 0.98; }
.dk-tut-text.dk-enter { opacity: 0; translate: 18px 0; }
.dk-tut-text.dk-enter.dk-enter--back { translate: -18px 0; }
.layout--desktop.chrome2 .dk-pop, .layout--desktop.chrome2 .dk-settings { transition-property: opacity, translate; }
.layout--desktop.chrome2 .sheet-title { transition-property: opacity, translate; transition-duration: 0.2s; }
.dk-anim-in { transition-property: opacity, translate; transition-duration: 0.4s; }
.desktop-ui .dk-b.dk-anim-in { transition-duration: 0.4s; }
.dk-crumb { transition-property: scale, background-color, border-color, color; transition-duration: 0.2s; }
.dk-crumb.dk-flash { scale: 1.08 1.08; background-color: rgba(70, 175, 255, 0.3); }
.desktop-tooltip { translate: 0 4px; transition-property: opacity, translate; transition-duration: 0.14s; }
.desktop-tooltip--visible { translate: 0 0; }
.desktop-tree-chevron, .foldout-chev { transition-property: rotate; transition-duration: 0.16s; transition-timing-function: ease-out; }
.dk-tut-text, .dk-tut-card { transition-property: opacity, translate, scale; transition-duration: 0.22s; transition-timing-function: ease-out; }
.dk-tut-row { transition-property: background-color, border-color; transition-duration: 0.2s; }
.dk-tut-row--hot { background-color: rgba(70, 175, 255, 0.12); border-color: rgba(70, 175, 255, 0.5); }
.dk-kbd, .dk-tut-cap { transition-property: scale, background-color, border-color; transition-duration: 0.1s; }
.dk-tut-cap.dk-press-sim, .dk-kbd.dk-press-sim { scale: 0.88 0.88; background-color: rgba(70, 175, 255, 0.4); border-color: rgb(70, 175, 255); }
.desktop-ui .dk-b.dk-press-sim { scale: 0.94 0.94; background-color: rgba(70, 175, 255, 0.28); }
.dk-tut-progress { position: relative; height: 3px; }
.dk-tut-fill { position: absolute; left: 0; top: 0; height: 3px; border-radius: 2px; background-color: rgb(70, 175, 255); transition-property: width; transition-duration: 0.3s; transition-timing-function: ease-out; }
.dk-tut-seg--cur, .dk-tut-seg--done { background-color: rgb(42, 48, 58); }
.dk-tut-anim { flex-grow: 1; align-self: stretch; }

/* Reduce animations (CONFIG): no transitions, no enter animations */
.dk-reduce-motion .dk-ibtn,
.dk-reduce-motion .dk-seg-btn,
.dk-reduce-motion .dk-strip-btn,
.dk-reduce-motion .dk-btn,
.dk-reduce-motion .dk-lang-btn,
.dk-reduce-motion .dk-status-btn,
.dk-reduce-motion.desktop-ui .dk-b,
.dk-reduce-motion.layout--desktop.chrome2 .dk-strip .submenu-card,
.dk-reduce-motion.layout--desktop.chrome2 .dk-pop .submenu-card,
.dk-reduce-motion.layout--desktop.chrome2 .dk-pop .cross-section-axis-btn,
.dk-reduce-motion.layout--desktop.chrome2 .dk-pop .cross-section-config-btn,
.dk-reduce-motion .desktop-tree-close,
.dk-reduce-motion .dk-tut-switch-btn,
.dk-reduce-motion .dk-config-embedded .config-cycle-btn,
.dk-reduce-motion .dk-config-embedded .config-tier-card,
.dk-reduce-motion .dk-config-embedded .config-tier-auto,
.dk-reduce-motion.layout--desktop.chrome2 .sheet-close-btn,
.dk-reduce-motion .dk-pop .submenu-back-btn,
.dk-reduce-motion .desktop-tree-row,
.dk-reduce-motion.layout--desktop.chrome2 .dk-pop,
.dk-reduce-motion.layout--desktop.chrome2 .dk-settings,
.dk-reduce-motion.layout--desktop.chrome2 .sheet-title,
.dk-reduce-motion .dk-crumb,
.dk-reduce-motion .dk-tut-text,
.dk-reduce-motion .dk-tut-card,
.dk-reduce-motion .dk-tut-row,
.dk-reduce-motion .dk-tut-cap,
.dk-reduce-motion .dk-kbd,
.dk-reduce-motion .desktop-tooltip,
.dk-reduce-motion .dk-anim-in,
.dk-reduce-motion .dk-pill,
.dk-reduce-motion .dk-tut-fill,
.dk-reduce-motion .desktop-tree-chevron,
.dk-reduce-motion .foldout-chev,
.dk-reduce-motion.layout--desktop.chrome2 .desktop-tree {
    transition-duration: 0s;
}

/* tutorial illustration (TutorialAnim): fills the art box; caption and key caps are small labels over the drawing */
.dk-tut-art .dk-tut-anim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.dk-tut-anim-cap { position: absolute; left: 6px; right: 6px; bottom: 6px; font-size: 12px; color: rgb(170, 180, 193); -unity-text-align: middle-center; white-space: normal; }
.dk-tut-anim-key { position: absolute; padding: 1px 8px; min-width: 22px; font-size: 12px; color: rgb(191, 234, 255); -unity-text-align: middle-center; border-width: 1px; border-color: rgba(255, 255, 255, 0.22); border-radius: 6px; background-color: rgb(11, 13, 17); transition-property: scale, background-color, border-color; transition-duration: 0.1s; }
.dk-reduce-motion .dk-tut-anim-key { transition-duration: 0s; }
.dk-tut-art { overflow: hidden; }

/* active-effect chips in the top bar (filter / exploded view / cut): subtle active tint, animated entrance and exit */
.dk-chip { color: rgb(191, 234, 255); background-color: rgba(70, 175, 255, 0.14); border-width: 1px; border-color: rgba(70, 175, 255, 0.45); transition-property: background-color, border-color, color, scale, translate, opacity; transition-duration: 0.18s; transition-timing-function: ease-out; }
.dk-chip .dk-icon { color: rgb(191, 234, 255); }
.dk-chip:hover { background-color: rgba(255, 120, 120, 0.18); border-color: rgba(255, 140, 140, 0.6); }
.dk-chip:hover .dk-icon { color: rgb(255, 214, 214); }
.dk-chip.dk-enter { opacity: 0; scale: 0.6 0.6; }
.dk-chip--out { opacity: 0; scale: 0.6 0.6; }
.dk-reduce-motion .dk-chip { transition-duration: 0s; }
.dk-top-slot { flex-direction: row; align-items: center; }

/* tutorial: selectable action rows, part label of the Inspect scene */
.dk-tut-row { transition-property: background-color, border-color, scale; }
.dk-tut-row:hover { background-color: rgba(70, 175, 255, 0.07); border-color: rgba(70, 175, 255, 0.35); }
.dk-tut-row--locked { background-color: rgba(70, 175, 255, 0.2); border-color: rgb(70, 175, 255); }
.dk-tut-anim-pop { position: absolute; padding: 2px 9px; font-size: 12px; color: rgb(6, 34, 47); background-color: rgb(191, 234, 255); border-radius: 10px; -unity-font-style: bold; }

/* ================================================================
   Phase 7 - telemetry (WP-11, PC only): mode 4 strip + popovers, status chip, "Vuelo" tab of the inspector.
   Colours only from design/tokens.json: accent rgb(70,175,255), highlight rgb(191,234,255), surfaces rgb(11,13,17) / rgb(18,21,27) / rgb(23,27,34) /
   rgb(27,32,41), lines rgba(255,255,255,.09|.16), texts rgb(255,255,255) / rgb(232,237,243) / rgb(219,228,238) / rgb(182,192,204) / rgb(139,149,163),
   states ok rgb(63,191,138), warn rgb(245,185,66), crit rgb(255,77,77). Origin tags: measured = ok, estimated = warn, simulated = accent.
   ================================================================ */

/* status chip (top bar, DkTopSlotFuture): link-state dot + the honest badge text; click opens mode 4 */
.dk-stchip {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    height: 28px;
    min-height: 0;
    max-width: 320px;
    margin: 0 4px;
    padding: 0 12px 0 10px;
    border-width: 1px;
    border-radius: 14px;
    border-color: rgba(255, 255, 255, 0.09);
    background-color: rgb(23, 27, 34);
    overflow: hidden;
    transition-property: background-color, border-color, color, scale, translate, opacity;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}
.dk-stchip:hover { background-color: rgb(27, 32, 41); border-color: rgba(70, 175, 255, 0.5); scale: 1.03 1.03; }
.dk-stchip:active { background-color: rgba(70, 175, 255, 0.22); border-color: rgba(70, 175, 255, 0.7); scale: 0.96 0.96; }
.dk-stchip--on { background-color: rgba(70, 175, 255, 0.08); border-color: rgba(70, 175, 255, 0.45); }
.dk-stchip.dk-flash { scale: 1.06 1.06; background-color: rgba(70, 175, 255, 0.3); }
.dk-keynav .dk-stchip:focus { border-width: 2px; border-color: rgb(70, 175, 255); }
.dk-stchip-text { flex-shrink: 1; margin: 0; padding: 0; font-size: 12.5px; color: rgb(219, 228, 238); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dk-stchip--on .dk-stchip-text { color: rgb(191, 234, 255); }

/* link-state dot (chip, tab, alert rows) */
.dk-dot { width: 8px; height: 8px; min-width: 8px; border-radius: 4px; margin: 0 7px 0 0; flex-shrink: 0; background-color: rgb(139, 149, 163); transition-property: opacity, background-color; transition-duration: 0.5s; transition-timing-function: ease-out; }
.dk-dot--off { background-color: rgb(139, 149, 163); }
.dk-dot--live { background-color: rgb(63, 191, 138); }
.dk-dot--connecting, .dk-dot--stale, .dk-dot--warn { background-color: rgb(245, 185, 66); }
.dk-dot--error, .dk-dot--crit { background-color: rgb(255, 77, 77); }
.dk-dot--dim { opacity: 0.3; }

/* mode 4 strip */
.dk-strip-state { margin: 0 0 0 8px; font-size: 11.5px; color: rgb(139, 149, 163); }
.dk-strip-state--live { color: rgb(63, 191, 138); }
.dk-strip-state--warn { color: rgb(245, 185, 66); }
.dk-strip-state--crit { color: rgb(255, 77, 77); }
.dk-strip--tel .dk-sep { margin: 0 5px; }
.dk-strip--tel .dk-kbd { margin-left: 8px; }
.dk-count { display: none; min-width: 16px; height: 16px; margin: 0 0 0 7px; padding: 0 5px; font-size: 11px; color: rgb(11, 13, 17); -unity-font-style: bold; -unity-text-align: middle-center; border-radius: 8px; background-color: rgb(139, 149, 163); }
.dk-count--warn { background-color: rgb(245, 185, 66); }
.dk-count--crit { background-color: rgb(255, 77, 77); }
.dk-strip-btn--alert .dk-icon { color: rgb(245, 185, 66); }

/* popovers of the strip */
.layout--desktop.chrome2 .dk-pop.dk-pop--w360 { width: 360px; }
.layout--desktop.chrome2 .dk-pop.dk-pop--w340 { width: 340px; }
.dk-note { margin: 2px 0 4px 0; padding: 0; font-size: 12px; color: rgb(182, 192, 204); white-space: normal; }
.dk-note--muted { font-size: 11.5px; color: rgb(139, 149, 163); }
.dk-note--warn { color: rgb(245, 185, 66); }
.dk-field-label { margin: 6px 0 3px 0; font-size: 11px; letter-spacing: 0.5px; color: rgb(139, 149, 163); }

.dk-src-row {
    flex-direction: row;
    align-items: flex-start;
    margin: 0 0 4px 0;
    padding: 8px 10px;
    border-width: 1px;
    border-radius: 10px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color, border-color, scale, opacity;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}
.dk-src-row:hover { background-color: rgb(27, 32, 41); border-color: rgba(70, 175, 255, 0.4); }
.dk-src-row:active { background-color: rgba(70, 175, 255, 0.22); scale: 0.99 0.99; }
.dk-src-row--on, .dk-src-row--on:hover { background-color: rgba(70, 175, 255, 0.16); border-color: rgba(70, 175, 255, 0.55); }
.dk-src-row--disabled, .dk-src-row--disabled:hover, .dk-src-row--disabled:active { opacity: 0.45; background-color: rgba(0, 0, 0, 0); border-color: rgba(0, 0, 0, 0); scale: 1 1; }
.dk-keynav .dk-src-row:focus, .dk-keynav .dk-alert-row:focus, .dk-keynav .dk-tab:focus { border-width: 2px; border-color: rgb(70, 175, 255); }
.dk-src-icon { margin: 2px 10px 0 0; }
.dk-src-row .dk-icon { color: rgb(182, 192, 204); }
.dk-src-row--on .dk-icon { color: rgb(191, 234, 255); }
.dk-src-col { flex-grow: 1; flex-shrink: 1; flex-basis: 0; }
.dk-src-title { margin: 0; font-size: 13px; color: rgb(232, 237, 243); -unity-font-style: bold; }
.dk-src-sub { margin: 1px 0 0 0; font-size: 12px; color: rgb(139, 149, 163); white-space: normal; }
.dk-src-badge { margin: 1px 0 0 0; font-size: 12px; color: rgb(191, 234, 255); white-space: normal; }
.dk-src-detail { margin: 2px 0 0 0; font-size: 11.5px; color: rgb(139, 149, 163); white-space: normal; }
.dk-sitl-block { margin: 0 0 2px 0; padding: 6px 10px 8px 10px; border-width: 1px; border-radius: 10px; border-color: rgba(255, 255, 255, 0.09); background-color: rgb(11, 13, 17); }
.dk-sitl-line { flex-direction: row; align-items: center; margin-top: 2px; }
.dk-sitl-field { flex-grow: 1; flex-shrink: 1; margin: 0 8px 0 0; height: 28px; }
.dk-sitl-field .unity-base-text-field__input { height: 28px; padding: 0 8px; font-size: 12.5px; color: rgb(219, 228, 238); border-width: 1px; border-radius: 8px; border-color: rgba(255, 255, 255, 0.16); background-color: rgb(23, 27, 34); }
.dk-sitl-field .unity-base-text-field__input:focus { border-color: rgb(70, 175, 255); }

/* alerts popover */
.dk-alert-list { max-height: 250px; margin-bottom: 4px; }
.dk-alert-row { flex-direction: row; align-items: flex-start; margin: 0 0 3px 0; padding: 7px 8px; border-width: 1px; border-radius: 10px; border-color: rgba(0, 0, 0, 0); background-color: rgba(0, 0, 0, 0); transition-property: background-color, border-color, scale; transition-duration: 0.14s; transition-timing-function: ease-out; }
.dk-alert-row:hover { background-color: rgb(27, 32, 41); border-color: rgba(70, 175, 255, 0.4); }
.dk-alert-row:active { background-color: rgba(70, 175, 255, 0.22); scale: 0.99 0.99; }
.dk-alert-row .dk-dot { margin: 5px 9px 0 0; }
.dk-alert-col { flex-grow: 1; flex-shrink: 1; flex-basis: 0; }
.dk-alert-msg { margin: 0; font-size: 12.5px; color: rgb(219, 228, 238); white-space: normal; }
.dk-alert-meta { margin: 1px 0 0 0; font-size: 11px; color: rgb(139, 149, 163); }

/* faults popover */
.dk-fault-tagrow { flex-direction: row; margin: 0 0 4px 0; }
.dk-fault-motor { flex-direction: row; align-items: center; margin: 2px 0 6px 0; }
.dk-fault-motor .dk-field-label { margin: 0 4px 0 0; }
.layout--desktop.chrome2 .dk-fault-mbtn, .desktop-ui .dk-b.dk-fault-mbtn { width: 30px; height: 26px; margin: 0 0 0 6px; padding: 0; }
.dk-fault-grid { flex-direction: row; flex-wrap: wrap; margin-bottom: 4px; }
.desktop-ui .dk-b.dk-fault-btn { width: 48.8%; height: 28px; margin: 2px 0.6%; padding: 0 6px; font-size: 12px; }
.dk-fault-active { margin-bottom: 4px; }
.dk-fault-row { margin: 1px 0; font-size: 12px; color: rgb(219, 228, 238); }

/* origin tags: measured = ok green, estimated = warn amber, simulated = celeste, command / not available = muted */
.dk-tag { margin: 0; padding: 1px 7px; font-size: 10.5px; color: rgb(139, 149, 163); -unity-text-align: middle-center; border-width: 1px; border-radius: 9px; border-color: rgba(255, 255, 255, 0.16); }
.dk-tag--measured { color: rgb(63, 191, 138); border-color: rgba(63, 191, 138, 0.5); background-color: rgba(63, 191, 138, 0.12); }
.dk-tag--estimated { color: rgb(245, 185, 66); border-color: rgba(245, 185, 66, 0.5); background-color: rgba(245, 185, 66, 0.12); }
.dk-tag--simulated { color: rgb(191, 234, 255); border-color: rgba(70, 175, 255, 0.55); background-color: rgba(70, 175, 255, 0.14); }
.dk-tag--command, .dk-tag--na { color: rgb(139, 149, 163); border-color: rgba(255, 255, 255, 0.16); background-color: rgba(0, 0, 0, 0); }

/* inspector tabs: Pieza | Vuelo */
.dk-sheet-tabs { flex-direction: row; flex-shrink: 0; padding: 8px 44px 2px 12px; }
.dk-tab { flex-direction: row; align-items: center; height: 26px; min-height: 0; margin: 0 4px 0 0; padding: 0 12px; border-width: 1px; border-radius: 13px; border-color: rgba(0, 0, 0, 0); background-color: rgba(0, 0, 0, 0); transition-property: background-color, border-color, color, scale, translate; transition-duration: 0.14s; transition-timing-function: ease-out; }
.dk-tab:hover { background-color: rgb(27, 32, 41); scale: 1.03 1.03; translate: 0 -1px; }
.dk-tab:active { scale: 0.96 0.96; translate: 0 0; }
.dk-tab-text { margin: 0; font-size: 13px; color: rgb(139, 149, 163); }
.dk-tab:hover .dk-tab-text { color: rgb(255, 255, 255); }
.dk-tab--on, .dk-tab--on:hover { background-color: rgba(70, 175, 255, 0.16); border-color: rgba(70, 175, 255, 0.55); }
.dk-tab--on .dk-tab-text, .dk-tab--on:hover .dk-tab-text { color: rgb(191, 234, 255); }
.dk-tab .dk-dot { margin: 0 6px 0 0; }

/* "Vuelo" tab content */
.dk-flight { display: none; flex-grow: 1; flex-shrink: 1; }
.dk-flight .unity-scroll-view__content-container { padding: 0 10px 10px 14px; }
.layout--desktop.chrome2 .dk-sheet--flight .dk-flight { display: flex; }
.layout--desktop.chrome2 .dk-sheet--flight #SheetContent_Details,
.layout--desktop.chrome2 .dk-sheet--flight .sheet-header,
.layout--desktop.chrome2 .dk-sheet--flight .dk-sheet-footer { display: none; }
.dk-fl-empty { align-items: center; padding: 30px 8px 10px 8px; }
.dk-fl-empty-icon { margin-bottom: 8px; color: rgb(139, 149, 163); }
.dk-fl-empty .dk-icon { color: rgb(139, 149, 163); }
.dk-fl-empty-title { margin: 0 0 6px 0; font-size: 14px; color: rgb(232, 237, 243); -unity-font-style: bold; }
.dk-fl-empty .dk-note { -unity-text-align: upper-center; }
.dk-fl-badge { margin: 4px 0 2px 0; font-size: 14px; color: rgb(191, 234, 255); -unity-font-style: bold; white-space: normal; }
.dk-fl-sec { margin: 12px 0 4px 0; padding: 0 0 3px 0; font-size: 11px; letter-spacing: 1px; color: rgb(139, 149, 163); -unity-font-style: bold; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.09); }
.dk-reading { flex-direction: row; align-items: center; min-height: 22px; }
.dk-reading-name { flex-grow: 1; flex-shrink: 1; margin: 0; font-size: 12.5px; color: rgb(139, 149, 163); }
.dk-reading-value { flex-shrink: 1; margin: 0 8px; font-size: 13px; color: rgb(255, 255, 255); -unity-text-align: middle-right; white-space: normal; }
.dk-reading .dk-tag { min-width: 62px; }
.dk-bat-bar { height: 4px; margin: 3px 0 4px 0; border-radius: 2px; background-color: rgba(255, 255, 255, 0.09); }
.dk-bat-fill { height: 4px; border-radius: 2px; background-color: rgb(63, 191, 138); }
.dk-bat-fill--low { background-color: rgb(245, 185, 66); }
.dk-bat-fill--crit { background-color: rgb(255, 77, 77); }
.dk-motor-heads { flex-direction: row; align-items: center; margin: 2px 0 4px 0; }
.dk-motor-heads .dk-reading-name { flex-grow: 0; margin-right: 6px; }
.dk-motor-heads .dk-tag { margin-right: 14px; }
.dk-motor { margin-bottom: 5px; }
.dk-motor-line { flex-direction: row; align-items: center; }
.dk-motor-name { flex-grow: 1; flex-shrink: 1; margin: 0; font-size: 12px; color: rgb(182, 192, 204); }
.dk-motor-val { width: 60px; margin: 0; font-size: 12.5px; color: rgb(255, 255, 255); -unity-text-align: middle-right; }
.dk-motor-u { height: 3px; margin-top: 2px; border-radius: 2px; background-color: rgba(255, 255, 255, 0.07); }
.dk-motor-ufill { height: 3px; border-radius: 2px; background-color: rgb(70, 175, 255); }

/* left-aligned text inside the popover rows (Button children inherit the centred text of the button) */
.dk-src-title, .dk-src-sub, .dk-src-badge, .dk-src-detail, .dk-alert-msg, .dk-alert-meta, .dk-note, .dk-field-label, .dk-fault-row { -unity-text-align: upper-left; }
.dk-fl-empty .dk-note { -unity-text-align: upper-center; }
.desktop-ui .dk-b--pill.dk-b--on, .desktop-ui .dk-b--pill.dk-b--on:hover { background-color: rgba(70, 175, 255, 0.16); border-color: rgba(70, 175, 255, 0.55); color: rgb(191, 234, 255); }

/* narrow windows: the top bar gives up the key caps of the modes, truncates a long part name and the status chip */
.dk-narrowbar .dk-seg-btn .dk-kbd { display: none; }
.dk-narrowbar .dk-seg-btn { padding: 0 10px; }
.dk-narrowbar .dk-crumb { flex-shrink: 1; max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dk-narrowbar .dk-stchip { max-width: 320px; flex-shrink: 0; }

.dk-reduce-motion .dk-stchip,
.dk-reduce-motion .dk-dot,
.dk-reduce-motion .dk-src-row,
.dk-reduce-motion .dk-alert-row,
.dk-reduce-motion .dk-tab { transition-duration: 0s; }
